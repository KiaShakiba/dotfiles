// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "languages": {
    "CSS": {
      "format_on_save": "on"
    },
    "SCSS": {
      "format_on_save": "on"
    },
    "JavaScript": {
      "format_on_save": "on"
    },
    "TypeScript": {
      "format_on_save": "on"
    },
    "Svelte": {
      "format_on_save": "on",
      "formatter": "prettier",
      "prettier": {
		"allowed": true,
		"plugins": ["prettier-plugin-svelte"],
      }
    },
    "JSON": {
      "format_on_save": "on"
    }
  },
  "show_signature_help_after_edits": true,
  "auto_signature_help": true,
  "git": {
    "inline_blame": {
      "location": "status_bar"
    }
  },
  "vertical_scroll_margin": 1000.0,
  "search": {
    "case_sensitive": true
  },
  "gutter": {
    "bookmarks": false,
    "breakpoints": false
  },
  "diff_view_style": "split",
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "collaboration_panel": {
    "button": false
  },
  "title_bar": {
    "show_sign_in": false,
    "show_menus": false
  },
  "completion_menu_item_kind": "symbol",
  "relative_line_numbers": "enabled",
  "tab_size": 4,
  "hard_tabs": true,
  "agent_buffer_font_size": 13.0,
  "agent_ui_font_size": 15.0,
  "cursor_blink": false,
  "buffer_line_height": "standard",
  "ui_font_family": ".ZedSans",
  "helix_mode": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "ui_font_size": 15.0,
  "buffer_font_size": 13.0,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Zedokai Darker (Filter Spectrum)",
  },
}
